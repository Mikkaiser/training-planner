{
  "name": "training-planner",
  "version": "0.1.0",
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "migrate": "tsx scripts/migrate.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "smoke": "tsx scripts/smoke.ts",
    "verify:capture": "tsx scripts/verify/capture.ts",
    "verify:s3": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify/s3-roundtrip.ts",
    "verify:flows": "tsx scripts/verify/flows.ts",
    "verify:orphans": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify/orphans.ts",
    "verify:responsive": "tsx scripts/verify/responsive.ts",
    "verify:affordance": "tsx scripts/verify/affordance.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm verify:s3 && pnpm verify:flows && pnpm verify:responsive && pnpm verify:affordance && pnpm verify:orphans",
    "build:check": "NEXT_DIST_DIR=.next-check next build",
    "verify:scheme": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify/scheme.ts",
    "scheme:build": "NODE_OPTIONS=--conditions=react-server tsx scripts/build-scheme.ts"
  },
  "dependencies": {
    "@auth/pg-adapter": "^1.11.3",
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@base-ui/react": "^1.4.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.99.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "next": "14.2.35",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.72.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.2.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.20.3",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
