# Postgres connection string
DATABASE_URL=postgresql://training_planner:password@localhost:5436/training_planner

# Auth.js. Generate a secret with: openssl rand -base64 33
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Google OAuth (Google Cloud Console > Credentials > OAuth 2.0 Client)
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-production-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# MinIO / S3
# When using docker-compose.dev.yml, the endpoint, bucket, region and path-style
# flag are set there and override these. Only the two keys are needed locally.
S3_ENDPOINT=https://s3.techknowledge.blog
S3_PUBLIC_ENDPOINT=https://s3.techknowledge.blog
S3_REGION=us-east-1
S3_BUCKET=training-planner-media-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# Transactional email for team invitations (Resend).
# Requires a verified domain: https://resend.com/docs/dashboard/domains/introduction
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Training Planner <team@example.com>
